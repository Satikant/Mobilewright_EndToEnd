# Copy to .env and fill in values. Never commit .env.

# --- App under test ---
PLATFORM=android
# Comma-separated: android | ios | android,ios
PROJECTS=android
BUNDLE_ID=com.example.myapp
ANDROID_APP=./apps/Androidapps.apk
IOS_APP=./apps/MyApp.zip
ANDROID_DEVICE_NAME=Pixel 9 Pro XL
IOS_DEVICE_NAME=iPhone 16
DEVICE_TYPE=emulator
OS_VERSION=

# --- Timeouts (ms) ---
TEST_TIMEOUT=120000
ACTION_TIMEOUT=8000
EXPECT_TIMEOUT=8000
APP_LAUNCH_TIMEOUT=30000

# --- Execution ---
WORKERS=1
FULLY_PARALLEL=false
RETRIES=0
CI=

# --- Database (optional) ---
# json (default) | mysql | postgres
DB_TYPE=json
DB_JSON_PATH=./testdata/db.json
# mysql://user:pass@localhost:3306/testdb
MYSQL_URL=
# postgres://user:pass@localhost:5432/testdb
POSTGRES_URL=

# --- Logging ---
LOG_LEVEL=info
LOG_DIR=./logs

# --- Cloud driver (optional) ---
MOBILENEXT_API_KEY=
